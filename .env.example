# Environment template — copy to .env and fill in real values.
# `cp .env.example .env`
#
# .env is gitignored. NEVER commit a real token or paste one into a README,
# an issue, or a chat: treat any token that has been exposed as compromised
# and revoke it in BotFather with /revoke.

# Telegram bot token from @BotFather
BOT_TOKEN=your-telegram-bot-token

# Your Telegram user ID (get it from @userinfobot). This user is always
# authorized, even without an entry in the admins table.
OWNER_ID=your-telegram-user-id

# Private admin group ID. Group IDs are negative; supergroups look like -100…
# Add the bot to the group, send a message there, and read the chat ID from
# the bot log or a getUpdates call.
ADMIN_GROUP_ID=your-admin-group-id

# Port for the keep-alive web server and the /api/support-request endpoint
PORT=3000
